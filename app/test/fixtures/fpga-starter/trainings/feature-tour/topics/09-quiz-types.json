            "w": 15,
            "h": 13,
            "id": "jtag"
          },
          {
            "x": 81.25,
            "y": 76,
            "w": 15,
            "h": 14,
            "id": "sd"
          }
        ],
        "correct": [
          "ddr"
        ],
        "review": [
          "types"
        ]
      }
    ]
  }
}
